# Copy this file to .env and keep the real values local.
#
# After `npm run build`, check one deployment role without opening network
# connections: `npm run check:deployment-env -- <role>`. Every Construction
# Root runs the same required-variable check before it creates an Adapter.
#
# Variables without defaults, by role:
# - api: BUSINESS_API_BASE_URL. When ASYNC_PROCESS_RUNS_ENABLED=true, also
#   DATABASE_URL, ASYNC_GATEWAY_SHARED_SECRET, the three PROCESS_RUN_*_RETENTION_MS
#   values, ASYNC_RELEASE_STAGE, and the three required backlog controls.
# - crt-business-api: IMAGE_PROVIDER, FAL_KEY, OBJECT_STORAGE_PROVIDER,
#   OSS_REGION, OSS_BUCKET, OSS_ACCESS_KEY_ID, and OSS_ACCESS_KEY_SECRET.
# - process-dispatcher: DATABASE_URL, REDIS_URL.
# - process-worker: BUSINESS_API_BASE_URL, DATABASE_URL, REDIS_URL, and the three
#   PROCESS_RUN_*_RETENTION_MS values.
# - webhook-worker: DATABASE_URL, REDIS_URL, WEBHOOK_SECRET_ENCRYPTION_KEY.
# - retention-cleaner: DATABASE_URL.
# - async-operations and process-recovery: DATABASE_URL, REDIS_URL. Queue Recovery
#   also requires PROCESS_RECOVERY_ACTOR_ID or an explicit --actor option.
# Provider credentials remain conditional. Deployment preflight and production
# startup require OPENAI_API_KEY for Agent roles when PI_PROVIDER=openai. FAL
# image experiments use FAL_KEY.

# Required when an Agent-backed Process, Skill A/B experiment, or image smoke uses OpenAI.
OPENAI_API_KEY=
# Keep this default for OpenAI, or replace it with an OpenAI-compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
# Use responses for gateways that implement POST /v1/responses.
OPENAI_API_MODE=chat-completions
# Paid image integration commands use openai by default. Select fal when the
# Agent gateway does not expose GPT Image 2 generation or editing.
IMAGE_PROVIDER=openai
# Required by the production CRT Business API; Compose fixes IMAGE_PROVIDER=fal.
FAL_KEY=
# Optional: use a separate OpenAI Images API when IMAGE_PROVIDER=openai.
# OPENAI_IMAGE_API_KEY=
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1

# Pi model selection. Set both values together.
PI_PROVIDER=openai
PI_MODEL=gpt-5.6-terra

# Business processing service. Required by the API and Process Worker. The owned
# API serves /process, /posters, and /crt-images.
BUSINESS_API_BASE_URL=http://127.0.0.1:4000
# Optional per-capability override. Production Compose owns this value and points
# it to the loopback-only CRT Business API.
# CRT_BUSINESS_API_BASE_URL=http://127.0.0.1:4400
PORT=4300
CONTENT_PROCESSING_MODE=direct
BUSINESS_API_TIMEOUT_MS=10000
POSTER_API_TIMEOUT_MS=90000
CRT_API_TIMEOUT_MS=180000
NEWS_IMAGE_API_TIMEOUT_MS=180000
PROCESS_TIMEOUT_MS=240000
# Pino threshold for Process Attempt and activity logs.
PROCESS_RUN_LOG_LEVEL=info
CONTENT_PROCESSING_RETRY_MAX_ATTEMPTS=1
CONTENT_PROCESSING_RETRY_INITIAL_DELAY_MS=1000
CONTENT_PROCESSING_RETRY_MAX_DELAY_MS=30000
HTTP_MAX_REQUEST_BODY_BYTES=262144
MAX_CONCURRENT_EXECUTIONS=4
TITLED_CONTENT_SEPARATOR=" — "

# Run Record archive and operator console.
#
# PROCESS_RUN_RECORD_STORE selects the storage. `file` (default) writes one JSON
# object per line into a file per UTC day and needs PROCESS_RUN_RECORD_DIRECTORY;
# `postgres` needs DATABASE_URL and is the production choice, because the
# database is backed up and listing and aggregation are queries. Either way the
# storage must outlive the container: a release otherwise loses its history.
# Leaving the file store without a directory keeps recording off, as before.
#
# Recording is independent of ASYNC_PROCESS_RUNS_ENABLED: a synchronous release
# still records what it did. The same storage also holds the Attempt activity
# timeline, which is written alongside the Pino stdout log, not instead of it.
PROCESS_RUN_RECORD_STORE=file
# PROCESS_RUN_RECORD_DIRECTORY=/var/lib/pipipi-run-records
# Connections shared with the record store only; pool size is separate from the
# async roles because recording must never starve them.
PROCESS_RUN_RECORD_POOL_MAX=4
# Bounds best-effort activity flushing and terminal record writes so observation
# degradation cannot consume Process Worker concurrency indefinitely.
PROCESS_RUN_OBSERVATION_TIMEOUT_MS=2000
# omit keeps business content out of the archive; accepted-input-and-output
# stores the accepted input and the output, so records can show what each run
# produced. crt-interface-image always stores a digest of sourceImageUrl, never
# the URL itself.
PROCESS_RUN_RECORD_CONTENT=omit
PROCESS_RUN_RECORD_RETENTION_DAYS=30
# The console has no authentication of its own. Keep it off unless the entry
# gateway authenticates it, or set an unguessable base path.
CONSOLE_ENABLED=false
CONSOLE_BASE_PATH=/console
# The Vite-only Gateway is off by default. Enable it only with
# `npm run dev:console`; it forwards /process-runs to the loopback API, strips
# browser-supplied identity headers, and injects console:development plus the
# server-side ASYNC_GATEWAY_SHARED_SECRET. Neither value enters the bundle.
CONSOLE_DEVELOPMENT_GATEWAY_ENABLED=false
CONSOLE_DEVELOPMENT_GATEWAY_TARGET=http://127.0.0.1:4300

# Async API route. Keep false for the default synchronous release.
ASYNC_PROCESS_RUNS_ENABLED=false
# Required by every async background role; the API reads it only when Async
# Process Runs are enabled.
# DATABASE_URL=postgres://service-user:replace-me@127.0.0.1:5432/business_processing
# ASYNC_GATEWAY_SHARED_SECRET=replace-with-at-least-32-random-bytes
# PROCESS_RUN_ACCEPTED_INPUT_RETENTION_MS=86400000
# PROCESS_RUN_RESULT_RETENTION_MS=604800000
# PROCESS_RUN_METADATA_RETENTION_MS=2592000000
# ASYNC_POSTGRES_POOL_MAX=10
# ASYNC_POSTGRES_CONNECTION_TIMEOUT_MS=5000
# The Worker requires this value to exceed PROCESS_TIMEOUT_MS.
# PROCESS_RUN_CLAIM_LEASE_MS=270000
# ASYNC_RETRY_AFTER_SECONDS=2
# Required admission and staged-release controls. internal is private traffic only;
# promote to canary/production only after the operational gates in the Runbook pass.
# ASYNC_RELEASE_STAGE=internal
# ASYNC_GLOBAL_BACKLOG_LIMIT=1000
# ASYNC_CALLER_BACKLOG_LIMIT=100
# ASYNC_BACKLOG_RETRY_AFTER_SECONDS=5
# ASYNC_STUCK_RUN_AGE_MS=300000
# ASYNC_MAX_STUCK_RUNS=0
# ASYNC_MAX_OUTBOX_LAG_MS=60000
# ASYNC_RECOVERY_MAX_AGE_MS=86400000
# ASYNC_OPERATIONS_RECENT_WINDOW_MS=900000

# Required by Process Dispatcher, Process Worker, Webhook Worker, Async
# Operations, and Process Recovery. Queue roles must use the expected prefixes.
# REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6380/0
# PROCESS_QUEUE_NAME=process-runs
# PROCESS_QUEUE_PREFIX=pipipi-local
# ASYNC_REDIS_CONNECTION_TIMEOUT_MS=5000
# RUNTIME_ROLE_READINESS_TIMEOUT_MS=2000

# Dispatcher-only scheduling and reconciliation.
# OUTBOX_DISPATCH_INTERVAL_MS=1000
# OUTBOX_DISPATCH_BATCH_SIZE=25
# OUTBOX_CLAIM_LEASE_MS=30000
# PROCESS_RUN_RECONCILE_INTERVAL_MS=30000
# PROCESS_RUN_RECONCILE_QUEUED_AGE_MS=60000
# PROCESS_RUN_RECONCILE_BATCH_SIZE=25
# Required only by the one-shot recover:queue command for manual audit ownership.
# PROCESS_RECOVERY_ACTOR_ID=operator:replace-me

# Worker-only execution settings. attempts remains server-owned and fixed at 1.
# PROCESS_WORKER_NAME=worker-local-1
# PROCESS_WORKER_CONCURRENCY=1
# PROCESS_WORKER_SHUTDOWN_GRACE_MS=30000
# PROCESS_WORKER_LOCK_DURATION_MS=30000
# PROCESS_WORKER_STALLED_INTERVAL_MS=30000
# PROCESS_WORKER_MAX_STALLED_COUNT=1

# Independent Webhook Worker role. Endpoint provisioning is an operations action.
# WEBHOOK_QUEUE_NAME=webhook-deliveries
# WEBHOOK_QUEUE_PREFIX=pipipi-local
# WEBHOOK_REQUEST_TIMEOUT_MS=20000
# WEBHOOK_DELIVERY_CLAIM_LEASE_MS=30000
# WEBHOOK_OUTBOX_DISPATCH_INTERVAL_MS=1000
# WEBHOOK_OUTBOX_DISPATCH_BATCH_SIZE=25
# WEBHOOK_OUTBOX_CLAIM_LEASE_MS=30000
# WEBHOOK_WORKER_NAME=webhook-local-1
# WEBHOOK_WORKER_CONCURRENCY=4
# WEBHOOK_WORKER_SHUTDOWN_GRACE_MS=30000
# WEBHOOK_WORKER_LOCK_DURATION_MS=30000
# WEBHOOK_WORKER_STALLED_INTERVAL_MS=30000
# WEBHOOK_WORKER_MAX_STALLED_COUNT=1
# Required by the Webhook Worker. Generate one 32-byte base64 key per environment.
# WEBHOOK_SECRET_ENCRYPTION_KEY=
# Delivery retry is PostgreSQL-authoritative; each retry creates a new outbox message.
# WEBHOOK_DELIVERY_MAX_ATTEMPTS=8
# WEBHOOK_DELIVERY_INITIAL_BACKOFF_MS=5000
# WEBHOOK_DELIVERY_MAX_BACKOFF_MS=86400000
# WEBHOOK_DELIVERY_MAX_RETRY_AFTER_MS=86400000
# WEBHOOK_DELIVERY_HORIZON_MS=259200000
# WEBHOOK_DELIVERY_JITTER_PERCENT=20
# Both overrides require NODE_ENV=test and an isolated local test environment.
# WEBHOOK_ALLOW_INSECURE_HTTP=false
# WEBHOOK_TEST_ALLOW_UNSAFE_TARGETS=false

# Independent retention cleanup role. Process content expiration timestamps are
# written by the Process Worker; Delivery history has its own retention period.
# WEBHOOK_DELIVERY_HISTORY_RETENTION_MS=2592000000
# RETENTION_CLEANUP_INTERVAL_MS=3600000
# RETENTION_CLEANUP_BATCH_SIZE=25
# RETENTION_CLEANUP_MAX_BATCHES_PER_SWEEP=100
# Local integration tests only; the database name must end in _test.
# POSTGRES_TEST_DATABASE_URL=postgres://pipipi:pipipi-test-only@127.0.0.1:55432/pipipi_test
# Async integration tests also require a local non-zero Redis database.
# REDIS_TEST_URL=redis://127.0.0.1:56379/15

# Optional Pi overrides.
# PI_AGENT_DIR=/absolute/path/to/pi/config
# Overrides only the fixed content-optimization binding; other production Skills stay bundled.
# PI_SKILL_DIRECTORY=/absolute/path/to/content-optimization
# Overrides only the fixed minimal-zine-poster-prompt binding.
# PI_POSTER_SKILL_DIRECTORY=/absolute/path/to/minimal-zine-poster-prompt
# Overrides only the fixed tait-crt-interface-prompt binding.
# PI_CRT_SKILL_DIRECTORY=/absolute/path/to/tait-crt-interface-prompt
# AGENT_SMOKE_CONTENT=Make this controlled release message clear and concise

# Explicit smoke test for an already deployed staging service.
# STAGING_SERVICE_BASE_URL=https://private-agent.example.internal
# STAGING_AUTHORIZATION=Bearer replace-with-short-lived-token
# STAGING_SMOKE_TIMEOUT_MS=180000
# STAGING_SMOKE_CONTENT=Rewrite this controlled MVP staging sentence clearly.

# Optional Skill A/B experiment overrides.
SKILL_AB_SKILL_FILE=.agents/skills/writing-clearly-and-concisely/SKILL.md
# SKILL_AB_REPORT_DIRECTORY=artifacts/skill-ab
# SKILL_AB_DRY_RUN=1
# SKILL_AB_CONTENT=Replace this with the same input for all experiment arms.

# Optional GPT Image 2 + poster business-acceptance overrides.
GPT_IMAGE_MODEL=gpt-image-2
GPT_IMAGE_SIZE=1024x1696
GPT_IMAGE_QUALITY=low
GPT_IMAGE_OUTPUT_FORMAT=png
GPT_IMAGE_TIMEOUT_MS=180000
GPT_IMAGE_AGENT_TIMEOUT_MS=120000
GPT_IMAGE_PROCESS_TIMEOUT_MS=310000
GPT_IMAGE_SKILL_DIRECTORY=.pi/skills/minimal-zine-poster-prompt
GPT_IMAGE_OBJECT_PREFIX=minimal-zine-poster
# GPT_IMAGE_REPORT_DIRECTORY=artifacts/gpt-image-2
# GPT_IMAGE_REQUIRED_TEXT=PIPIPI ZINE
# GPT_IMAGE_THEME=Create a minimal zine poster about a rainy used bookstore. Include the exact text PIPIPI ZINE.

# Optional GPT Image 2 reference-edit smoke for crt-interface-image/v1.
# This smoke writes artifacts and incurs image-model cost; it does not run the finalizer.
# CRT_SOURCE_IMAGE_FILE=/absolute/path/to/non-sensitive-test-image.png
# accept:crt-business uses this public HTTPS URL directly with FAL.
# CRT_SOURCE_IMAGE_URL=https://images.example.com/source.png
CRT_IMAGE_MODEL=gpt-image-2
CRT_IMAGE_SIZE=1600x1200
CRT_IMAGE_QUALITY=low
CRT_IMAGE_TIMEOUT_MS=180000
# Production Compose owns these internal listener values.
# CRT_BUSINESS_API_HOST=127.0.0.1
# CRT_BUSINESS_API_PORT=4400
# CRT_IMAGE_WORK_DIRECTORY=/tmp/pipipi-crt-business
# CRT_IMAGE_REPORT_DIRECTORY=artifacts/crt-interface-image
# CRT_IMAGE_PROMPT=Override only when testing a reviewed prompt change.
# accept:crt-business defaults to full, per-run local evidence. The production
# CRT Business API must default to off unless retention is explicitly approved.
# CRT_IMAGE_EVIDENCE_MODE=full
# CRT_IMAGE_EVIDENCE_DIRECTORY=artifacts/crt-interface-image/acceptance/runs
# CRT_ACCEPTANCE_REPORT_DIRECTORY=artifacts/crt-interface-image/acceptance
CRT_IMAGE_OBJECT_PREFIX=crt-interface-image

# Optional for local tests. Production Compose requires aliyun-oss.
OBJECT_STORAGE_PROVIDER=none
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Use a short-lived token with the temporary AccessKey pair when available.
# OSS_STS_TOKEN=
OSS_URL_ACCESS=signed
OSS_SIGNED_URL_TTL_SECONDS=3600
OSS_TIMEOUT_MS=60000
# New mainland China OSS users need a bound custom domain for data access.
# OSS_ENDPOINT=https://oss-upload.example.com
# OSS_CNAME=true
# Public/CDN delivery only. The bucket or CDN must already allow reads.
# OSS_URL_ACCESS=public
# OSS_PUBLIC_BASE_URL=https://assets.example.com
# OSS_SMOKE_FILE=artifacts/gpt-image-2/latest.png
# OSS_SMOKE_OBJECT_PREFIX=object-storage-smoke
# OSS_SMOKE_REPORT_FILE=artifacts/object-storage/latest.json
