# Copy this file to .env and keep the real values local.

# Required when an Agent, the Skill A/B experiment, or the image smoke test uses OpenAI.
OPENAI_API_KEY=
# Keep this default for OpenAI, or replace it with an OpenAI-compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
# Use responses for gateways that implement POST /v1/responses.
OPENAI_API_MODE=chat-completions

# Pi model selection. Set both values together.
PI_PROVIDER=openai
PI_MODEL=gpt-5.6-terra

# Business processing service.
BUSINESS_API_BASE_URL=http://127.0.0.1:4000
PORT=3000
CONTENT_PROCESSING_MODE=direct
BUSINESS_API_TIMEOUT_MS=10000
PROCESS_TIMEOUT_MS=120000
CONTENT_PROCESSING_RETRY_MAX_ATTEMPTS=1
CONTENT_PROCESSING_RETRY_INITIAL_DELAY_MS=1000
CONTENT_PROCESSING_RETRY_MAX_DELAY_MS=30000
HTTP_MAX_REQUEST_BODY_BYTES=262144
MAX_CONCURRENT_EXECUTIONS=4
TITLED_CONTENT_SEPARATOR=" — "

# Async API route. Keep false for the default synchronous release.
ASYNC_PROCESS_RUNS_ENABLED=false
# DATABASE_URL=postgres://service-user:replace-me@127.0.0.1:5432/business_processing
# ASYNC_GATEWAY_SHARED_SECRET=replace-with-at-least-32-random-bytes
# PROCESS_RUN_ACCEPTED_INPUT_RETENTION_MS=86400000
# PROCESS_RUN_RESULT_RETENTION_MS=604800000
# PROCESS_RUN_METADATA_RETENTION_MS=2592000000
# ASYNC_POSTGRES_POOL_MAX=10
# ASYNC_POSTGRES_CONNECTION_TIMEOUT_MS=5000
# The Worker requires this value to exceed PROCESS_TIMEOUT_MS.
# PROCESS_RUN_CLAIM_LEASE_MS=150000
# ASYNC_RETRY_AFTER_SECONDS=2

# Dispatcher and Worker roles. Both roles must use the same Queue name and prefix.
# REDIS_URL=redis://127.0.0.1:6379/0
# PROCESS_QUEUE_NAME=process-runs
# PROCESS_QUEUE_PREFIX=pipipi-local
# ASYNC_REDIS_CONNECTION_TIMEOUT_MS=5000
# RUNTIME_ROLE_READINESS_TIMEOUT_MS=2000

# Dispatcher-only scheduling and reconciliation.
# OUTBOX_DISPATCH_INTERVAL_MS=1000
# OUTBOX_DISPATCH_BATCH_SIZE=25
# OUTBOX_CLAIM_LEASE_MS=30000
# PROCESS_RUN_RECONCILE_INTERVAL_MS=30000
# PROCESS_RUN_RECONCILE_QUEUED_AGE_MS=60000
# PROCESS_RUN_RECONCILE_BATCH_SIZE=25

# Worker-only execution settings. attempts remains server-owned and fixed at 1.
# PROCESS_WORKER_NAME=worker-local-1
# PROCESS_WORKER_CONCURRENCY=1
# PROCESS_WORKER_SHUTDOWN_GRACE_MS=30000
# PROCESS_WORKER_LOCK_DURATION_MS=30000
# PROCESS_WORKER_STALLED_INTERVAL_MS=30000
# PROCESS_WORKER_MAX_STALLED_COUNT=1

# Independent Webhook Worker role. Endpoint provisioning is an operations action.
# WEBHOOK_QUEUE_NAME=webhook-deliveries
# WEBHOOK_QUEUE_PREFIX=pipipi-local
# WEBHOOK_REQUEST_TIMEOUT_MS=20000
# WEBHOOK_DELIVERY_CLAIM_LEASE_MS=30000
# WEBHOOK_OUTBOX_DISPATCH_INTERVAL_MS=1000
# WEBHOOK_OUTBOX_DISPATCH_BATCH_SIZE=25
# WEBHOOK_OUTBOX_CLAIM_LEASE_MS=30000
# WEBHOOK_WORKER_NAME=webhook-local-1
# WEBHOOK_WORKER_CONCURRENCY=4
# WEBHOOK_WORKER_SHUTDOWN_GRACE_MS=30000
# WEBHOOK_WORKER_LOCK_DURATION_MS=30000
# WEBHOOK_WORKER_STALLED_INTERVAL_MS=30000
# WEBHOOK_WORKER_MAX_STALLED_COUNT=1
# Never enable outside an isolated local test environment.
# WEBHOOK_ALLOW_INSECURE_HTTP=false
# Local integration tests only; the database name must end in _test.
# POSTGRES_TEST_DATABASE_URL=postgres://pipipi:pipipi-test-only@127.0.0.1:55432/pipipi_test
# Async integration tests also require a local non-zero Redis database.
# REDIS_TEST_URL=redis://127.0.0.1:56379/15

# Optional Pi overrides.
# PI_AGENT_DIR=/absolute/path/to/pi/config
# PI_SKILL_DIRECTORY=/absolute/path/to/content-optimization
# AGENT_SMOKE_CONTENT=Make this controlled release message clear and concise

# Explicit smoke test for an already deployed staging service.
# STAGING_SERVICE_BASE_URL=https://private-agent.example.internal
# STAGING_AUTHORIZATION=Bearer replace-with-short-lived-token
# STAGING_SMOKE_TIMEOUT_MS=180000
# STAGING_SMOKE_CONTENT=Rewrite this controlled MVP staging sentence clearly.

# Optional Skill A/B experiment overrides.
SKILL_AB_SKILL_FILE=.agents/skills/writing-clearly-and-concisely/SKILL.md
# SKILL_AB_REPORT_DIRECTORY=artifacts/skill-ab
# SKILL_AB_DRY_RUN=1
# SKILL_AB_CONTENT=Replace this with the same input for all experiment arms.

# Optional GPT Image 2 + poster Skill smoke-test overrides.
GPT_IMAGE_MODEL=gpt-image-2
GPT_IMAGE_SIZE=1024x1696
GPT_IMAGE_QUALITY=low
GPT_IMAGE_OUTPUT_FORMAT=png
GPT_IMAGE_TIMEOUT_MS=180000
GPT_IMAGE_AGENT_TIMEOUT_MS=120000
GPT_IMAGE_SKILL_DIRECTORY=.agents/skills/gc-minimal-zine-poster-v0-1
GPT_IMAGE_OBJECT_PREFIX=gpt-image-2
# GPT_IMAGE_REPORT_DIRECTORY=artifacts/gpt-image-2
# GPT_IMAGE_REQUIRED_TEXT=PIPIPI ZINE
# GPT_IMAGE_THEME=Create a minimal zine poster about a rainy used bookstore. Include the exact text PIPIPI ZINE.

# Optional generated-asset storage. Keep none for local-only tests.
OBJECT_STORAGE_PROVIDER=none
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Use a short-lived token with the temporary AccessKey pair when available.
# OSS_STS_TOKEN=
OSS_URL_ACCESS=signed
OSS_SIGNED_URL_TTL_SECONDS=3600
OSS_TIMEOUT_MS=60000
# New mainland China OSS users need a bound custom domain for data access.
# OSS_ENDPOINT=https://oss-upload.example.com
# OSS_CNAME=true
# Public/CDN delivery only. The bucket or CDN must already allow reads.
# OSS_URL_ACCESS=public
# OSS_PUBLIC_BASE_URL=https://assets.example.com
# OSS_SMOKE_FILE=artifacts/gpt-image-2/latest.png
# OSS_SMOKE_OBJECT_PREFIX=object-storage-smoke
# OSS_SMOKE_REPORT_FILE=artifacts/object-storage/latest.json
