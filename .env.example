# Copy this file to .env and keep the real values local.

# Required when an Agent, the Skill A/B experiment, or the image smoke test uses OpenAI.
OPENAI_API_KEY=
# Keep this default for OpenAI, or replace it with an OpenAI-compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
# Use responses for gateways that implement POST /v1/responses.
OPENAI_API_MODE=chat-completions

# Pi model selection. Set both values together.
PI_PROVIDER=openai
PI_MODEL=gpt-5.6-terra

# Business processing service.
BUSINESS_API_BASE_URL=http://127.0.0.1:4000
PORT=3000
CONTENT_PROCESSING_MODE=direct
BUSINESS_API_TIMEOUT_MS=10000
PROCESS_TIMEOUT_MS=120000
HTTP_MAX_REQUEST_BODY_BYTES=262144
MAX_CONCURRENT_EXECUTIONS=4
TITLED_CONTENT_SEPARATOR=" — "

# Optional Pi overrides.
# PI_AGENT_DIR=/absolute/path/to/pi/config
# PI_SKILL_DIRECTORY=/absolute/path/to/content-optimization
# AGENT_SMOKE_CONTENT=Make this controlled release message clear and concise

# Explicit smoke test for an already deployed staging service.
# STAGING_SERVICE_BASE_URL=https://private-agent.example.internal
# STAGING_AUTHORIZATION=Bearer replace-with-short-lived-token
# STAGING_SMOKE_TIMEOUT_MS=180000
# STAGING_SMOKE_CONTENT=Rewrite this controlled MVP staging sentence clearly.

# Optional Skill A/B experiment overrides.
SKILL_AB_SKILL_FILE=.agents/skills/writing-clearly-and-concisely/SKILL.md
# SKILL_AB_REPORT_DIRECTORY=artifacts/skill-ab
# SKILL_AB_DRY_RUN=1
# SKILL_AB_CONTENT=Replace this with the same input for all experiment arms.

# Optional GPT Image 2 + poster Skill smoke-test overrides.
GPT_IMAGE_MODEL=gpt-image-2
GPT_IMAGE_SIZE=1024x1696
GPT_IMAGE_QUALITY=low
GPT_IMAGE_OUTPUT_FORMAT=png
GPT_IMAGE_TIMEOUT_MS=180000
GPT_IMAGE_AGENT_TIMEOUT_MS=120000
GPT_IMAGE_SKILL_DIRECTORY=.agents/skills/gc-minimal-zine-poster-v0-1
GPT_IMAGE_OBJECT_PREFIX=gpt-image-2
# GPT_IMAGE_REPORT_DIRECTORY=artifacts/gpt-image-2
# GPT_IMAGE_REQUIRED_TEXT=PIPIPI ZINE
# GPT_IMAGE_THEME=Create a minimal zine poster about a rainy used bookstore. Include the exact text PIPIPI ZINE.

# Optional generated-asset storage. Keep none for local-only tests.
OBJECT_STORAGE_PROVIDER=none
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Use a short-lived token with the temporary AccessKey pair when available.
# OSS_STS_TOKEN=
OSS_URL_ACCESS=signed
OSS_SIGNED_URL_TTL_SECONDS=3600
OSS_TIMEOUT_MS=60000
# New mainland China OSS users need a bound custom domain for data access.
# OSS_ENDPOINT=https://oss-upload.example.com
# OSS_CNAME=true
# Public/CDN delivery only. The bucket or CDN must already allow reads.
# OSS_URL_ACCESS=public
# OSS_PUBLIC_BASE_URL=https://assets.example.com
# OSS_SMOKE_FILE=artifacts/gpt-image-2/latest.png
# OSS_SMOKE_OBJECT_PREFIX=object-storage-smoke
# OSS_SMOKE_REPORT_FILE=artifacts/object-storage/latest.json
