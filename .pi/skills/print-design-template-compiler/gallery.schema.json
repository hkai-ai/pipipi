{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipipi:template-from-image:v3:runtime-v4",
  "title": "GalleryTemplateImport",
  "description": "批量导入 memebuy 后端 GalleryTemplate 表的单模板文件契约。身份优先使用内部 id 或外部 sourceIdentity；两者都没有的运营旧格式按唯一 key 回退。图片字段给本地路径（CLI 会上传 OSS 后回填为 *Url 列）或 http(s) URL（直通不重传）。带 export 标记的键是后台导出才产出的可选键，手写文件不必带；带了才生效，不带一律沿用库里旧值。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "title",
    "promptTemplate",
    "inputSchema"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "isFeaturedStyle"
        ],
        "properties": {
          "isFeaturedStyle": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "STYLE_REF"
          },
          "makerKey": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "description": "我方模板的跨环境稳定唯一身份。内部原生数据用 pnpm gallery:template:id 生成一次后固定保留。外部数据已提供 sourceIdentity 时可省略；若两者同时存在，id 只用于首次显式绑定历史模板，之后必须与已有映射一致。历史模板若已受控归并，继续提交归并前的旧 id 会自动解析到当前主模板。"
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "id"
      ],
      "description": "外部维护方自己的稳定身份。系统持久化 (source, id) → GalleryTemplate.id 映射；缺失时允许按唯一 key 兼容匹配。",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "pattern": "^[a-z][a-z0-9._-]+$",
          "description": "数据源命名空间，由接入方固定使用，例如 partner-a 或 design-team.catalog；不同来源可复用相同外部 id。"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "description": "模板在该外部来源内的稳定唯一 ID；可读性不限，但一经使用不得更换或复用给另一模板。"
        }
      }
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "ARCHIVED",
        null
      ],
      "description": "【后台导出产出，可选】上下架状态。带了就按它落；不带则默认 PUBLISHED，且 metadata.needsReview 非空时强降 DRAFT。"
    },
    "isFeaturedStyle": {
      "type": "boolean",
      "description": "运营精选风格。可选，省略时保留目标库现值，新建默认 false；显式 false 取消。true 必须同时声明 kind=STYLE_REF，且模板不能归属 Maker。排序复用 sortOrder。"
    },
    "sortOrder": {
      "type": [
        "integer",
        "null"
      ],
      "description": "【后台导出产出，可选】人工排序值。不写这个键就不动库里的现有排序。"
    },
    "makerKey": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": "【后台导出产出，可选】归属的 maker（小工具）。不写这个键就不动库里的归属；显式写 null 才是清空。写错会让 maker 模板脱离 maker、混进 C 端公开模板目录。"
    },
    "featureKeys": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "maxLength": 60
      },
      "description": "【后台导出产出，可选】所属专题的 key 列表（不是 id）。导入时按 key 挂回，**只加不减**：本环境已有、文件里没写的归属会保留。key 在本环境不存在只 warn 不拦。"
    },
    "kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PROMPT",
        "STYLE_REF",
        "SKILL",
        null
      ],
      "description": "模板类别。PROMPT（缺省）= 提示词模板，提示词随模板下发给 C 端、用户可编辑；STYLE_REF = 风格参考，提示词保密且强制使用模板参考图；SKILL = 用户填写结构化参数，由专用算法或外部服务执行，提示词不参与 C 端交互。不写这个键就不动库里的现有类别。",
      "default": "PROMPT"
    },
    "remoteRunKind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "gallery.crt_image",
        null
      ],
      "description": "Skill 的外部执行能力键，不是 API 地址或模板 ID。代码目录将它映射成 process/version；不写这个键就不动库里的现有绑定。"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,59}$",
      "description": "可读、允许重复的业务标识。缺少 id/sourceIdentity 时作为兼容匹配键：零候选新建、唯一候选更新、多候选失败；key-only 模式改名无法自动关联旧模板。小写字母开头，仅小写字母/数字/连字符，2-60 字符。"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "模板标题。"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300,
      "description": "模板简介，超长请截断到 300 字符。"
    },
    "cover": {
      "type": [
        "string",
        "null"
      ],
      "description": "封面图【本地文件路径】。导入脚本传 OSS 后回填到 DB 列 coverUrl。"
    },
    "referenceImage": {
      "type": [
        "string",
        "null"
      ],
      "description": "模板自带参考图【本地文件路径】，作为生成的固定参考图（DB 列 templateImageUrl）。注意：这是模板级的一张固定图，与 inputSchema 里的 image 输入槽（终端用户上传）完全无关。"
    },
    "imageSize": {
      "type": "string",
      "pattern": "^\\d{2,4}x\\d{2,4}$",
      "default": "1024x1024",
      "description": "出图尺寸，形如 1024x1024。入库时会吸附到 5 档正典尺寸之一（1024x1024 / 896x1152 / 1152x896 / 768x1344 / 1344x768）；不填则从封面实测宽高推导。"
    },
    "backgroundPreference": {
      "type": "string",
      "enum": [
        "inherit",
        "transparent",
        "original"
      ],
      "description": "表单默认背景偏好；新建省略时继承平台，更新省略时保留现值。用户选择优先。"
    },
    "printPlacementPreference": {
      "type": "string",
      "enum": [
        "inherit",
        "front-left-chest",
        "front-chest-center",
        "front-large-center",
        "front-full",
        "back-upper-center",
        "back-large-center",
        "back-full"
      ],
      "description": "商品预览与编辑器初始摆放偏好；新建省略时为 inherit（跟随品类默认），更新省略时保留现值。只影响预览落位，不参与生成。"
    },
    "imageN": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "description": "单次出图张数。"
    },
    "stageKey": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": "生成能力 stage 标识（可空）。"
    },
    "promptTemplate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "提示词模板【可执行字段，语法固定】。占位为兜底链：{{ term | term | \"字面量默认\" }}，从左到右取第一个非空项。term 是点路径：{{inputId}} 取该输入值；{{selectId.key}} 取选中项 payload[key]；{{stepId.field}} 取预处理步产出的 JSON 字段。双引号内是字面量兜底。所有 term 引用的 head id 必须在 inputSchema 或 preprocessSteps 中已定义。"
    },
    "promptEnhancement": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "stageKey",
        "instruction",
        "output"
      ],
      "description": "【可执行字段，结构固定】v2 提示词增强层：落定 promptTemplate 后再交文本模型改写一次。省略则运行时回落全局默认 merge。",
      "properties": {
        "stageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "改写用的 stage（如 gallery.prompt_rewrite）。必须是运维已在 AiStageBinding 绑好的 stage。"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "内部改写目标（不得改变用户创作意图）。"
        },
        "referenceField": {
          "type": "string",
          "enum": [
            "referenceImage"
          ],
          "description": "存在模板参考图时固定填 referenceImage。"
        },
        "lockedConstraints": {
          "type": "array",
          "maxItems": 30,
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": "最终提示词必须执行的结构/风格硬约束。"
        },
        "preserve": {
          "type": "array",
          "maxItems": 30,
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": "必须保留的语义锚点。"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "promptField"
          ],
          "description": "输出契约固定，照抄即可。",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "json"
              ]
            },
            "promptField": {
              "type": "string",
              "enum": [
                "finalPrompt"
              ]
            }
          }
        }
      }
    },
    "runtimeSemantics": {
      "oneOf": [
        {
          "$ref": "#/$defs/runtimeSemantics"
        },
        {
          "type": "null"
        }
      ],
      "description": "新模板运行语义固定 v3：目标声明 appearance/pose，全局 visualContract 不混入目标外观；v1/v2 原样兼容。导入了拆解数据（designSpec）的模板写 v4（无 visualContract，当前只可入库与展示，尚不能生成）。"
    },
    "inputSchema": {
      "$ref": "#/$defs/inputContractV2",
      "description": "终端用户输入合同【可执行字段】。新模板固定 version=2；每个槽位独立声明 text、image 或二者兼有。"
    },
    "preprocessSteps": {
      "type": "array",
      "maxItems": 4,
      "default": [],
      "description": "AI 预处理步【可执行字段，结构固定】。worker 侧异步执行，产出 JSON 供 {{stepId.field}} 引用。无预处理给 []。step id 与 inputSchema 的 id 共享命名空间、不得撞名。判别联合 vision/text。",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/visionStep"
          },
          {
            "$ref": "#/$defs/textStep"
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "description": "所有我方没有专列的模板元数据整包存这里（DB 列 metadata Json?，原样保存、零丢失）。Agent 觉得有价值的分类/风格/版本等都放这。约定额外铺一个扁平 tags 数组，供未来筛选/再识别。",
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "扁平标签数组（从分类体系铺平），未来按 metadata.tags 筛选。"
        },
        "needsReview": {
          "type": [
            "string",
            "null"
          ],
          "description": "把握不准/需人工复核的模板在此写原因（非空字符串）。导入脚本读到非空 → 强制该模板 status=DRAFT，不上线（其余默认 PUBLISHED）。"
        },
        "editablePrompt": {
          "type": [
            "string",
            "null"
          ],
          "description": "可选：人类可读的提示词预览原文（无占位）。仅留档展示用，不参与生成——生成只跑 promptTemplate。"
        },
        "templateSource": {
          "type": [
            "object",
            "null"
          ],
          "description": "可选：原图的结构/构图信息留档。注意：这里只是留档，任何必须生效的硬约束（构图、锁定项）都要同时写进 promptTemplate，否则不会作用于生成。",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "runtimeSemanticsV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "targetInstances",
        "inputBindings",
        "visualContract"
      ],
      "properties": {
        "version": {
          "const": 3
        },
        "targetInstances": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "$ref": "#/$defs/runtimeTargetInstanceV3"
          }
        },
        "inputBindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/runtimeInputBinding"
          }
        },
        "visualContract": {
          "$ref": "#/$defs/runtimeVisualContractV3"
        }
      }
    },
    "runtimeIdentitySubjectTargetV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "region"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,79}$"
        },
        "kind": {
          "const": "identity_subject"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "groupId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,79}$"
        },
        "appearance": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "pose": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "runtimeContentElementTargetV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "region"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,79}$"
        },
        "kind": {
          "const": "content_element"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "groupId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,79}$"
        },
        "appearance": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "pose": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "runtimeIdentityGroupTargetV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "region",
        "memberKind",
        "minMembers",
        "maxMembers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,79}$"
        },
        "kind": {
          "const": "identity_group"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "memberKind": {
          "type": "string",
          "enum": [
            "person",
            "pet"
          ]
        },
        "minMembers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxMembers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "appearance": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "pose": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "runtimeTargetInstanceV3": {
      "oneOf": [
        {
          "$ref": "#/$defs/runtimeIdentitySubjectTargetV3"
        },
        {
          "$ref": "#/$defs/runtimeContentElementTargetV3"
        },
        {
          "$ref": "#/$defs/runtimeIdentityGroupTargetV3"
        }
      ]
    },
    "runtimeVisualContractV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "medium",
        "styleTraits",
        "composition",
        "relations"
      ],
      "properties": {
        "medium": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "styleTraits": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "composition": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "relations": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "colorAndLight": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "runtimeSemantics": {
      "$ref": "#/$defs/runtimeSemanticsV4"
    },
    "runtimeSemanticsV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "targetInstances",
        "inputBindings",
        "designSpec"
      ],
      "description": "拆解数据：无 visualContract；targetInstances 的 id 与 designSpec 元素或配色角色一一对应；replace_content 必须声明 valueKind，color 只在 v4 允许。字段见 agent-template-json-runtime-contract.md 的 v4 一节。",
      "properties": {
        "version": {
          "const": 4
        },
        "targetInstances": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "$ref": "#/$defs/runtimeTargetInstanceV3"
          }
        },
        "inputBindings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/runtimeInputBinding"
          }
        },
        "designSpec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier",
            "whole",
            "elements",
            "signatureFeatures",
            "lockedInstances",
            "bannedWords",
            "printFit",
            "defaults"
          ],
          "properties": {
            "tier": {
              "enum": [
                "same_method",
                "signature",
                "same_design"
              ]
            },
            "whole": {
              "type": "object"
            },
            "elements": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "type": "object"
              }
            },
            "signatureFeatures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lockedInstances": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "bannedWords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "printFit": {
              "type": "object"
            },
            "defaults": {
              "type": "object"
            }
          }
        }
      }
    },
    "runtimeSemanticsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "targetInstances",
        "inputBindings",
        "visualContract"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "targetInstances": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "$ref": "#/$defs/runtimeTargetInstanceV1"
          }
