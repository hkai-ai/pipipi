        "prompt"
      ],
      "description": "文本改写预处理：按 prompt 改写/扩写文本 → 产出 JSON（{{stepId.field}} 引用）。",
      "properties": {
        "type": {
          "const": "text"
        },
        "id": {
          "$ref": "#/$defs/inputId",
          "description": "步骤 id = 产出变量名。"
        },
        "stageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "改写指令，可含 {{输入}} 与 {{前序步骤.field}}。"
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "cache": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
