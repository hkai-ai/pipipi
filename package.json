{
  "name": "pi-business-processing-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "dev:dispatcher": "node --env-file-if-exists=.env --watch --import tsx src/process-dispatcher-main.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch --import tsx src/process-worker-main.ts",
    "dev:webhook-worker": "node --env-file-if-exists=.env --watch --import tsx src/webhook-worker-main.ts",
    "dev:retention-cleaner": "node --env-file-if-exists=.env --watch --import tsx src/retention-cleaner-main.ts",
    "dev:business-api": "tsx watch examples/business-api.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:api": "node --env-file-if-exists=.env dist/main.js",
    "start:dispatcher": "node --env-file-if-exists=.env dist/process-dispatcher-main.js",
    "start:worker": "node --env-file-if-exists=.env dist/process-worker-main.js",
    "start:webhook-worker": "node --env-file-if-exists=.env dist/webhook-worker-main.js",
    "start:retention-cleaner": "node --env-file-if-exists=.env dist/retention-cleaner-main.js",
    "start:operations": "node --env-file-if-exists=.env dist/async-operations-main.js",
    "recover:queue": "node --env-file-if-exists=.env --import tsx src/queue-recovery-main.ts",
    "observe:async": "node --env-file-if-exists=.env --import tsx src/async-operations-main.ts",
    "smoke:agent": "node --env-file-if-exists=.env --import tsx examples/agent-smoke.ts",
    "smoke:staging": "node --env-file-if-exists=.env --import tsx examples/staging-smoke.ts",
    "smoke:oss": "node --env-file-if-exists=.env --import tsx examples/aliyun-oss-smoke.ts",
    "test:skill-ab": "node --env-file-if-exists=.env --import tsx examples/skill-ab-experiment.ts",
    "test:gpt-image-2": "node --env-file-if-exists=.env --import tsx examples/gpt-image-2-skill-smoke.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:postgres": "RUN_POSTGRES_INTEGRATION=1 vitest run test/postgres-process-run-store.integration.test.ts",
    "test:integration:async": "RUN_ASYNC_INTEGRATION=1 vitest run test/bullmq-process-runtime.integration.test.ts",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --advisory-lock-mode wait"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "ali-oss": "^6.23.0",
    "bullmq": "6.0.9",
    "ioredis": "6.0.0",
    "pg": "^8.23.0",
    "typebox": "^1.3.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "24.13.3",
    "@types/pg": "^8.21.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
