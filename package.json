{
    "name": "pi-business-processing-service",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --env-file-if-exists=.env --watch --import tsx src/bin/api.ts",
        "dev:api": "node --env-file-if-exists=.env --watch --import tsx src/bin/api.ts",
        "dev:dispatcher": "node --env-file-if-exists=.env --watch --import tsx src/bin/dispatcher.ts",
        "dev:worker": "node --env-file-if-exists=.env --watch --import tsx src/bin/process-worker.ts",
        "dev:webhook-worker": "node --env-file-if-exists=.env --watch --import tsx src/bin/webhook-worker.ts",
        "dev:retention-cleaner": "node --env-file-if-exists=.env --watch --import tsx src/bin/retention-cleaner.ts",
        "dev:business-api": "node --env-file-if-exists=.env --watch --import tsx src/bin/crt-business-api.ts",
        "build": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/bin/api.js",
        "start:api": "node --env-file-if-exists=.env dist/bin/api.js",
        "start:business-api": "node --env-file-if-exists=.env dist/bin/crt-business-api.js",
        "start:dispatcher": "node --env-file-if-exists=.env dist/bin/dispatcher.js",
        "start:worker": "node --env-file-if-exists=.env dist/bin/process-worker.js",
        "start:webhook-worker": "node --env-file-if-exists=.env dist/bin/webhook-worker.js",
        "start:retention-cleaner": "node --env-file-if-exists=.env dist/bin/retention-cleaner.js",
        "start:operations": "node --env-file-if-exists=.env dist/bin/operations.js",
        "check:deployment-env": "node --env-file-if-exists=.env dist/bin/check-deployment-environment.js",
        "recover:queue": "node --env-file-if-exists=.env --import tsx src/bin/recover.ts",
        "observe:async": "node --env-file-if-exists=.env --import tsx src/bin/operations.ts",
        "smoke:agent": "node --env-file-if-exists=.env --import tsx examples/agent-smoke.ts",
        "smoke:staging": "node --env-file-if-exists=.env --import tsx examples/staging-smoke.ts",
        "smoke:oss": "node --env-file-if-exists=.env --import tsx examples/aliyun-oss-smoke.ts",
        "test:skill-ab": "node --env-file-if-exists=.env --import tsx examples/skill-ab-experiment.ts",
        "accept:poster-business": "node --env-file-if-exists=.env --import tsx examples/poster-business-acceptance.ts",
        "smoke:poster-process": "npm run accept:poster-business",
        "test:gpt-image-2": "npm run accept:poster-business",
        "smoke:crt-gpt-image": "node --env-file-if-exists=.env --import tsx examples/crt-gpt-image-smoke.ts",
        "accept:crt-business": "node --env-file-if-exists=.env --import tsx examples/crt-business-acceptance.ts",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration:postgres": "RUN_POSTGRES_INTEGRATION=1 vitest run test/postgres-process-run-store.integration.test.ts",
        "test:integration:observation": "RUN_POSTGRES_INTEGRATION=1 vitest run test/postgres-run-observation.integration.test.ts",
        "test:integration:async": "RUN_ASYNC_INTEGRATION=1 vitest run test/bullmq-process-runtime.integration.test.ts",
        "db:migrate": "node-pg-migrate up --migrations-dir migrations --advisory-lock-mode wait"
    },
    "dependencies": {
        "@earendil-works/pi-coding-agent": "^0.84.1",
        "@fal-ai/client": "^1.10.1",
        "ali-oss": "^6.23.0",
        "bullmq": "6.0.9",
        "ioredis": "6.0.0",
        "node-pg-migrate": "^9.0.0",
        "pg": "^8.23.0",
        "pino": "^10.3.1",
        "sharp": "^0.35.3",
        "typebox": "^1.3.7",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.7",
        "@types/ali-oss": "^6.23.3",
        "@types/node": "24.13.3",
        "@types/pg": "^8.21.0",
        "tsx": "4.23.11",
        "typescript": "7.0.2",
        "vitest": "4.1.10"
    },
    "engines": {
        "node": ">=24"
    }
}
